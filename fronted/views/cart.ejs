<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Корзина — Пожарный Щит</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* шрифт и палитра — как на главной странице */
        body {
            font-family: 'Montserrat', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            padding: 40px;
            background: #f4f5f7;
            color: #1f2733;
        }
        h1 { font-size: 30px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 24px; }
        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 22px rgba(31, 39, 51, 0.08);
        }
        th, td { padding: 15px; border-bottom: 1px solid #eef0f3; text-align: left; font-size: 15px; }
        th { background: #1f2733; color: white; font-weight: 600; }
        tr:last-child td { border-bottom: none; }
        .total-row { font-weight: 700; font-size: 1.15em; background: #fafbfc; }
        .empty-msg { text-align: center; padding: 20px; color: #6b7684; }
    </style>
</head>
<body>
    <h1> Ваша корзина</h1>

<table>
    <thead>
        <tr>
                <th>Наименование товара</th>
                <th>Цена за ед.</th>
                <th>Кол-во</th>
            <th>Сумма</th>
        </tr>
    </thead>
    <tbody>
            <% if (products.length > 0) { %>
                <% products.forEach(function(item) { %>
                <tr>
                        <td><%= item.name %></td>
                        <td><%= item.price %> ₽</td>
                        <td><%= item.quantity %> шт.</td>
                        <td><%= item.price * item.quantity %> ₽</td>
                    </tr>
                <% }); %>
                <tr class="total-row">
                    <td colspan="3" style="text-align: right;">ИТОГО:</td>
                    <td><%= total %> ₽</td>
                </tr>
        <% } else { %>
                <tr>
                    <td colspan="4" class="empty-msg">Корзина пуста. Выберите товары в каталоге!</td>
                </tr>
        <% } %>
    </tbody>
</table>

    <br>
    <a href="/">Вернуться в магазин</a>
    <div style="margin-top: 30px; background: white; padding: 20px; border: 1px solid #ddd;">
    <h3>Оформить заказ</h3>
    <form onsubmit="sendOrder(); return false;">
        <input type="tel" name="phone" id="phoneInput" placeholder="Ваш номер телефона" required 
               style="padding: 10px; width: 250px;">
        <button type="submit" onclick="sendOrder()" style="padding: 10px 20px; background: #28a745; color: white; border: none; cursor: pointer;">
            Заказать
        </button>
        <span id="statusMessage" style="margin-left: 15px; font-weight: bold;"></span>
    </form>
</div>
</body>
<script>
    function sendOrder() {
        const phoneInput = document.getElementById('phoneInput')
        const status=document.getElementById('statusMessage')

        const phone = phoneInput.value.trim();

    if (!phone) {
        status.style.color = "red";
        status.innerText = "Введите номер!";
        return;
    }
    status.style.color = "blue";
    status.innerText = "Отправка...";
        
    const params = new URLSearchParams();
    params.append('phone', phone);
        fetch('/checkout', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'phone=' + encodeURIComponent(phone)
        })
        .then(response => response.text())
        .then(data => {
            if (data === "success") {
                status.style.color = "#28a745";
                status.innerHTML = "Данные успешно отправлены! Мы свяжемся с вами."

                document.getElementById('phoneInput').value = "";
                setTimeout(() => {
                    status.innerText = "";
                }, 3000);
            } else {
                status.style.color = "red"
                status.innerText = "Ошибка:" + data;
            }
        })
    };        
</script>
</html>